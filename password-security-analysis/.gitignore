# --- Leaked / generated password data -------------------------------------
# rockyou.txt is a real breach: never commit it.
data/raw/*
!data/raw/.gitkeep

# Generated by the pipeline (rebuild with the scripts, ~1 minute)
data/processed/*
!data/processed/.gitkeep

# Samples: random_sample.csv and challenge_sample.csv are harmless.
# rockyou_sample.csv contains 100k REAL leaked passwords. Commit it only if
# the repository is PRIVATE; otherwise uncomment the next line.
# data/samples/rockyou_sample.csv

# --- Models -----------------------------------------------------------------
models/*.joblib
models/*.pkl

# --- Python -----------------------------------------------------------------
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.env
.ipynb_checkpoints/
